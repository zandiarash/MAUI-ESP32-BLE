@* Inline SVG icon set (24 px grid, 2 px strokes, currentColor). Directional icons carry "icon-flip"
   so they mirror in right-to-left layouts. *@

<span class="@($"app-icon {(Flips ? "icon-flip" : string.Empty)} {Class}")" aria-hidden="true">
    <svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false">
        @switch (Name)
        {
            case "devices":
                <rect x="3" y="3" width="7.5" height="7.5" rx="2" />
                <rect x="13.5" y="3" width="7.5" height="7.5" rx="2" />
                <rect x="3" y="13.5" width="7.5" height="7.5" rx="2" />
                <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2" />
                break;
            case "plus":
                <path d="M12 5v14M5 12h14" />
                break;
            case "settings":
                <circle cx="12" cy="12" r="3" />
                <path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M5.3 18.7l2.1-2.1M16.6 7.4l2.1-2.1" />
                break;
            case "refresh":
                <path d="M20 11a8 8 0 1 0-2.3 5.7" />
                <path d="M20 4v7h-7" />
                break;
            case "chevron":
                <path d="M9 5l7 7-7 7" />
                break;
            case "back":
                <path d="M15 5l-7 7 7 7" />
                break;
            case "close":
                <path d="M6 6l12 12M18 6L6 18" />
                break;
            case "more":
                <circle cx="12" cy="5" r="1.2" fill="currentColor" />
                <circle cx="12" cy="12" r="1.2" fill="currentColor" />
                <circle cx="12" cy="19" r="1.2" fill="currentColor" />
                break;
            case "wifi":
                <path d="M2.5 8.5a14 14 0 0 1 19 0" />
                <path d="M5.5 12a9.5 9.5 0 0 1 13 0" />
                <path d="M8.5 15.5a5 5 0 0 1 7 0" />
                <circle cx="12" cy="19" r="1" fill="currentColor" />
                break;
            case "wifi-off":
                <path d="M3 3l18 18" />
                <path d="M8.5 15.5a5 5 0 0 1 5.6-1" />
                <path d="M5.5 12a9.5 9.5 0 0 1 4-2.3" />
                <path d="M2.5 8.5a14 14 0 0 1 4.2-2.7" />
                <circle cx="12" cy="19" r="1" fill="currentColor" />
                break;
            case "bluetooth":
                <path d="M7 7l10 10-5 5V2l5 5L7 17" />
                break;
            case "switch":
                <rect x="2.5" y="7" width="19" height="10" rx="5" />
                <circle cx="16.5" cy="12" r="3" fill="currentColor" />
                break;
            case "unknown":
                <rect x="3" y="3" width="18" height="18" rx="4" />
                <path d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3" />
                <circle cx="12" cy="17" r=".9" fill="currentColor" />
                break;
            case "identify":
                <circle cx="12" cy="12" r="4" />
                <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
                break;
            case "power":
                <path d="M12 3v8" />
                <path d="M6.3 7.3a8 8 0 1 0 11.4 0" />
                break;
            case "trash":
                <path d="M4 7h16M9 7V4.5h6V7M6.5 7l1 13h9l1-13" />
                break;
            case "reset":
                <path d="M4 11a8 8 0 1 1 2.3 5.7" />
                <path d="M4 4v7h7" />
                break;
            case "edit":
                <path d="M4 20h4L19 9l-4-4L4 16z" />
                <path d="M13.5 6.5l4 4" />
                break;
            case "info":
                <circle cx="12" cy="12" r="9" />
                <path d="M12 11v5" />
                <circle cx="12" cy="7.8" r=".9" fill="currentColor" />
                break;
            case "warning":
                <path d="M12 3.5L2.5 20h19z" />
                <path d="M12 10v4.5" />
                <circle cx="12" cy="17.2" r=".9" fill="currentColor" />
                break;
            case "check":
                <circle cx="12" cy="12" r="9" />
                <path d="M8 12.5l2.7 2.7L16 9.8" />
                break;
            case "error":
                <circle cx="12" cy="12" r="9" />
                <path d="M9 9l6 6M15 9l-6 6" />
                break;
            case "lock":
                <rect x="5" y="10.5" width="14" height="10" rx="2" />
                <path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" />
                break;
            case "globe":
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z" />
                break;
            case "theme":
                <circle cx="12" cy="12" r="9" />
                <path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor" />
                break;
            case "flask":
                <path d="M9.5 3h5M10 3v6L4.5 19a1.5 1.5 0 0 0 1.3 2h12.4a1.5 1.5 0 0 0 1.3-2L14 9V3" />
                <path d="M7.5 15h9" />
                break;
            case "router":
                <rect x="3" y="13" width="18" height="7" rx="2" />
                <path d="M7 16.5h.01M10.5 16.5h.01M15 13V9M9.5 7.5a3.5 3.5 0 0 1 5 0" />
                break;
            default:
                <circle cx="12" cy="12" r="9" />
                break;
        }
    </svg>
</span>

@code {
    private static readonly HashSet<string> Directional = ["chevron", "back", "refresh", "reset"];

    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public string? Class { get; set; }

    private bool Flips => Directional.Contains(Name);
}
