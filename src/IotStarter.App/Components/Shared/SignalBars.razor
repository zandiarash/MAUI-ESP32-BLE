@inject IStringLocalizer<Strings> L

@* Four bars from RSSI (dBm). *@
<span class="signal-bars" role="img" aria-label="@L["Common.Signal", Bars]">
    @for (int i = 1; i <= 4; i++)
    {
        <span class="@(i <= Bars ? "on" : null)" style="@($"block-size:{4 + (i * 3)}px")"></span>
    }
</span>

@code {
    [Parameter]
    public int Rssi { get; set; }

    private int Bars => Rssi switch
    {
        >= -55 => 4,
        >= -67 => 3,
        >= -75 => 2,
        >= -85 => 1,
        _ => 0
    };
}
